<b:if cond='data:view.isHomepage'>__HERO__</b:if>
<b:section class='journal-body' id='journal' maxwidgets='1' showaddelement='false'>
  <b:widget id='Blog1' locked='true' title='Journal' type='Blog' version='2' visible='true'>
    <b:widget-settings>
      <b:widget-setting name='showShareButtons'>false</b:widget-setting>
      <b:widget-setting name='showCommentLink'>true</b:widget-setting>
      <b:widget-setting name='showAuthor'>true</b:widget-setting>
      <b:widget-setting name='showLabels'>true</b:widget-setting>
      <b:widget-setting name='showTimestamp'>true</b:widget-setting>
      <b:widget-setting name='showInlineAds'>false</b:widget-setting>
    </b:widget-settings>
    <b:includable id='main'>
      <b:if cond='data:view.isSingleItem'>
        <div class='reader-toolbar'><a expr:href='data:blog.homepageUrl'>← All writing</a>__TYPE_CONTROLS__</div>
        <b:loop values='data:posts' var='post'><b:include data='post' name='reader'/></b:loop>
      <b:else/>
        <b:if cond='data:view.isHomepage and data:posts.any'>
          <b:loop index='i' values='data:posts' var='post'><b:if cond='data:i == 0'><b:include data='post' name='lead'/></b:if></b:loop>
        </b:if>
        <section class='writing' id='writing' aria-labelledby='writing-heading' data-blog-rendered='true'>
          <div class='section-heading'>
            <h2 id='writing-heading'>
              <b:if cond='data:view.isLabelSearch'><data:view.search.label/>
              <b:elseif cond='data:view.isSearch'/>Search <em>results.</em>
              <b:elseif cond='data:view.isArchive'/>From the <em>archive.</em>
              <b:else/>Collected <em>writing.</em></b:if>
            </h2><span class='micro muted'>The journal / An ongoing collection</span>
          </div>
          __FILTERS__
          <b:if cond='data:posts.any'>
            <div class='post-list'>
              <b:loop index='i' values='data:posts' var='post'>
                <b:if cond='not data:view.isHomepage or data:i != 0'><b:include data='post' name='entry'/></b:if>
              </b:loop>
            </div>
          <b:else/><p class='empty'>No writing found here yet. <a expr:href='data:blog.homepageUrl'>Return to the journal.</a></p></b:if>
          <nav class='pagination' aria-label='Post pagination'>
            <b:if cond='data:newerPageUrl'><a class='text-link' expr:href='data:newerPageUrl'>← Newer writing</a></b:if>
            <a class='text-link' href='#archive'>Explore the index ↗</a>
            <b:if cond='data:olderPageUrl'><a class='text-link older' expr:href='data:olderPageUrl'>Older writing <span class='arrow' aria-hidden='true'>↗</span></a></b:if>
          </nav>
        </section>
      </b:if>
    </b:includable>
    <b:includable id='entry' var='post'>
      <article>
        <a class='post-row' expr:href='data:post.url' expr:data-post-id='data:post.id'>
          <span class='micro muted row-no' aria-hidden='true'></span>
          <div><h3 class='post-title'><b:if cond='data:post.title'><data:post.title/><b:else/>Untitled</b:if></h3><p data-fill='excerpt'></p></div>
          <div class='post-meta micro'><b:if cond='data:post.labels'><span><data:post.labels.first.name/></span></b:if><time data-fill='date'></time></div>
          <span class='row-arrow' aria-hidden='true'>↗</span>
        </a>
      </article>
    </b:includable>
    <b:includable id='lead' var='post'>
      <article class='lead' expr:data-post-id='data:post.id'>
        <a class='lead-art' expr:href='data:post.url' expr:aria-label='data:post.title ?: "Read the latest writing"'>
          <b:if cond='data:post.featuredImage'><b:class name='has-image'/><img expr:src='resizeImage(data:post.featuredImage, 1000)' expr:alt='data:post.title' loading='lazy' width='1000' height='750'/><b:else/>__STUDY__</b:if>
        </a>
        <div class='lead-copy'><div class='lead-meta micro'><span>01 / The opening page</span><b:if cond='data:post.labels'><span class='muted'><data:post.labels.first.name/></span></b:if></div><h2 class='lead-title'><a expr:href='data:post.url'><b:if cond='data:post.title'><data:post.title/><b:else/>Untitled</b:if></a></h2><p data-fill='excerpt-long'></p><a class='text-link' expr:href='data:post.url'>Read the story <span class='arrow' aria-hidden='true'>↗</span></a></div>
      </article>
    </b:includable>
    <b:includable id='reader' var='post'>
      <article class='reading-page' data-blog-rendered='true' expr:data-post-id='data:post.id'>
        <b:include data='post' name='postMetadataJSON'/>
        <div class='micro muted'><b:if cond='data:post.labels'><data:post.labels.first.name/><b:else/>The Yellow Bottle</b:if></div>
        <h1 class='article-title'><b:if cond='data:post.title'><data:post.title/><b:else/>Untitled</b:if></h1>
        <div class='article-byline'><span><data:post.author.name/></span><b:if cond='data:view.isPost'><time data-fill='date'></time></b:if></div>
        <div class='article-body post-body entry-content' expr:id='"post-body-" + data:post.id'><data:post.body/></div>
        <b:if cond='data:post.labels'><nav class='article-labels' aria-label='Post labels'><b:loop values='data:post.labels' var='label'><a expr:href='data:label.url' rel='tag'><data:label.name/></a></b:loop></nav></b:if>
        <div class='article-end'><a expr:href='data:blog.homepageUrl'>← All writing</a><button data-copy='true' type='button' aria-live='polite'>Copy link ↗</button></div>
        <b:if cond='data:post.allowComments'><b:include data='post' name='commentPicker'/></b:if>
      </article>
    </b:includable>
    __COMMENTS__
  </b:widget>
</b:section>
